{
  "schema": "mmf.applicant-approval-authorization/v1",
  "action": "applications:approve",
  "default_role": "member",
  "complete_facts": [
    "reviewer_id", "organization_id", "application_id", "application_status",
    "risk_score", "document_verification_passed", "biometric_match_score",
    "evidence_count", "applicant_country"
  ],
  "score_range": {"minimum": 0, "maximum": 100},
  "valid_member_decision": "allow",
  "invalid_or_incomplete_decision": "error",
  "inactive_reviewer_decision": "deny"
}
